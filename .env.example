# Supabase project details -- Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps: two SEPARATE keys, restricted differently.
# Browser key (Maps JavaScript API) -- restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key (Geocoding API) -- restrict by IP / keep secret, never expose to the browser.
GOOGLE_MAPS_SERVER_API_KEY=
